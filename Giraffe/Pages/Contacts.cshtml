<main>
    <div class="container">
        <div class="separation">
            <p>КОНТАКТЫ И АДРЕС</p>
            <p>GIRAFFE</p>
        </div>
        <div class="adressAndLoc">
            <div class="contacts">
                <div class="contact-info">
                    <h3>Контакты</h3>
                    <div>
                        <p><img src="/img/phoneWhite.png" alt="Phone Icon">+7 926 396 5139</p>
                        <p><img src="/img/mailWhite.png" alt="Email Icon">ask@giraffeprint.ru</p>
                    </div>
                </div>
            </div>
            <div class="adress">
                <div class="adress-info">
                    <h3>Адрес</h3>
                    <p><img src="/img/geo.png" alt="Phone Icon">г. Москва, Шоссе энтузиастов 31с50, д. 16, стр. 25
                        (территория завода «ГрафитЭЛ») Ежедневно с 10:00 до 20:00</p>
                </div>
            </div>
        </div>

    </div>
</main>